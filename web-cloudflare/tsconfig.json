{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "allowJs": true, "checkJs": false, "noEmit": true, "skipLibCheck": true,
    "jsx": "react-jsx", "jsxImportSource": "preact",
    "types": ["@cloudflare/workers-types"], "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["worker/**/*.js", "src/**/*.js", "src/**/*.jsx", "shared/**/*.js"]
}
