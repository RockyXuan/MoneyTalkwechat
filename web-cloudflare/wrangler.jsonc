{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moneytalk-web",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-14",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
  "vars": { "ENVIRONMENT": "production" },
  "d1_databases": [{ "binding": "DB", "database_name": "moneytalk-web-production", "database_id": "91436c72-99e9-4ef7-9160-37249d546eef", "migrations_dir": "migrations" }],
  "env": {
    "local": {
      "name": "moneytalk-local",
      "workers_dev": false,
      "vars": { "ENVIRONMENT": "local", "LOCAL_DEV_MODE": "true" },
      "d1_databases": [{ "binding": "DB", "database_name": "moneytalk-local", "database_id": "00000000-0000-0000-0000-000000000001", "migrations_dir": "migrations" }]
    }
  }
}
